@model PlacementDashboard.Models.Student

@{
    ViewBag.Title = "Add Student";
}

<style>
    .add-box {
        background: white;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        margin-top: 30px;
    }

        .add-box h2 {
            color: #1e3a8a;
            font-weight: bold;
            margin-bottom: 25px;
        }

    .form-control {
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 15px;
    }
</style>

<div class="add-box">
    <h2>Add New Student</h2>

    @using (Html.BeginForm())
    {
        <label>Student Name</label>
        @Html.TextBoxFor(m => m.StudentName, new { @class = "form-control", required = "required" })

        <label>Branch</label>
        @Html.TextBoxFor(m => m.Branch, new { @class = "form-control", required = "required" })

        <label>CGPA</label>
        @Html.TextBoxFor(m => m.CGPA, new { @class = "form-control", type = "number", step = "0.1", required = "required" })

        <label>Email</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })

        <label>Company</label>
        @Html.TextBoxFor(m => m.Company, new { @class = "form-control", required = "required" })

        <label>Status</label>
        @Html.DropDownListFor(m => m.Status,
            new SelectList(new[] { "Placed", "Pending", "Not Placed" }),
            "Select Status",
            new { @class = "form-control", required = "required" })

        <button type="submit" class="btn btn-primary">Add Student</button>
        <a href="@Url.Action("Index", "Placement")" class="btn btn-secondary">Back</a>
    }
</div>